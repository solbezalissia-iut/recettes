rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Alissia (la propriétaire du site) peut tout modifier / tout supprimer,
    // y compris les recettes d'origine et celles ajoutées par les autres.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email == 'solbezrigaudalissia@gmail.com';
    }

    match /recipes/{recipeId} {
      // Tout le monde peut lire les recettes ajoutées (pas besoin de compte pour consulter).
      allow read: if true;

      // Il faut être connecté pour créer une recette, et elle doit t'appartenir.
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.titre is string
                    && request.resource.data.titre.size() > 0;

      // On peut modifier / supprimer une recette dont on est déjà propriétaire
      // (sans pouvoir en changer le propriétaire), ou bien être Alissia (isAdmin()).
      allow update: if isAdmin()
                    || (request.auth != null
                        && resource.data.ownerId == request.auth.uid
                        && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin()
                    || (request.auth != null
                        && resource.data.ownerId == request.auth.uid);
    }

    // Planning de la semaine + liste de courses : chaque compte Google a son
    // propre document (planning/{uid}). Le propriétaire peut le partager avec
    // d'autres comptes (champ sharedWith = adresses e-mail en minuscules).
    match /planning/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function myEmail() {
        return request.auth.token.email.lower();
      }
      function isGuest() {
        return request.auth != null
               && request.auth.token.email != null
               && request.auth.token.email_verified == true
               && myEmail() in resource.data.get('sharedWith', []);
      }

      // Le propriétaire et les personnes invitées peuvent lire.
      allow read: if isOwner() || isGuest();

      // Seul le propriétaire crée / supprime son planning et choisit avec qui il est partagé.
      allow create, delete: if isOwner();

      // Le propriétaire modifie tout ; une personne invitée modifie seulement
      // les semaines (repas + courses) et le frigo, ou se retire elle-même du partage.
      allow update: if isOwner()
                    || (isGuest()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weeks', 'frigo', 'updatedAt']))
                    || (isGuest()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharedWith'])
                        && request.resource.data.sharedWith == resource.data.sharedWith.removeAll([myEmail()]));
    }

    // Plannings partagés : séparés du planning perso, chacun avec sa semaine,
    // ses courses, son frigo et un nom. members = adresses e-mail (minuscules)
    // des personnes qui le voient, la créatrice comprise.
    match /shared_plannings/{planId} {
      function myEmail() {
        return request.auth.token.email.lower();
      }
      function signedIn() {
        return request.auth != null
               && request.auth.token.email != null
               && request.auth.token.email_verified == true;
      }
      function isCreator() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      function isMember() {
        return signedIn() && myEmail() in resource.data.members;
      }

      allow read: if isCreator() || isMember();

      // On crée un planning partagé à son nom, en étant dans la liste des personnes.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && myEmail() in request.resource.data.members;

      // La créatrice modifie tout (nom, personnes…). Les autres modifient la semaine,
      // les courses, le frigo et le nom, ou se retirent eux-mêmes.
      allow update: if isCreator()
                    || (isMember()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weeks', 'frigo', 'updatedAt', 'name']))
                    || (isMember()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                        && request.resource.data.members == resource.data.members.removeAll([myEmail()]));

      // Seule la créatrice peut le supprimer.
      allow delete: if isCreator();
    }

    // Liste des recettes d'origine (du fichier recettes-data.js) qu'Alissia a
    // choisi de masquer ou de remplacer. Réservé à Alissia.
    match /hidden_static_recipes/{staticId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
